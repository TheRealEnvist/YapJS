{
  "name": "yapjs",
  "version": "0.7.0",
  "description": "An unofficial, dependency-free Node.js library for building Yapper bots",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "yapper",
    "bot",
    "sdk",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRealEnvist/YapJS.git"
  },
  "bugs": {
    "url": "https://github.com/TheRealEnvist/YapJS/issues"
  },
  "homepage": "https://github.com/TheRealEnvist/YapJS#readme",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.mjs",
    "**/*.d.ts"
  ]
}

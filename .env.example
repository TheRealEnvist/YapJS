# Optional public project key override (the example includes Yapper's published key).
YAPPER_API_KEY=
# Optional: base64-encoded 32-byte key for session.enc.json; store separately.
YAPPER_SESSION_KEY=
# Only needed when initializing your own independent session. Keep real values private.
YAPPER_SESSION=
# Copy the Value of yp:1n00fw from Yapper's browser Local Storage; keep it private.
# See docs/authentication.md for the developer-tools walkthrough.
YAPPER_VALUE=
# Test bot only: optional session file path relative to this repository root.
# YAPPER_SESSION_FILE=.data/test-bot-session.json
# Text commands are enabled in the example bot; disable with 0.
YAPPER_ENABLE_COMMANDS=1
YAPPER_PREFIX=!
# Comma-separated IDs authorized for commands marked ownerOnly.
YAPPER_OWNER_IDS=

# Optional profile customization (omit a field to leave it alone; empty clears text).
# YAPPER_BIO=Your bot bio
# YAPPER_DISPLAY_NAME=My Helper
# YAPPER_CUSTOM_STATUS=Here to help
# YAPPER_PRONOUNS=they/them
# YAPPER_ACCENT_COLOR="#5865f2"
# Optional heartbeat presence: online, idle, dnd, invisible, or offline.
# The test bot defaults to online and renews its heartbeat every 45 seconds.
# YAPPER_STATUS=online
# YAPPER_ACTIVITY=Helping the community

# Optional: log server messages to the console (off by default).
YAPPER_LOG_MESSAGES=0

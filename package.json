{
  "name": "yapperjs",
  "version": "0.7.0",
  "description": "An unofficial, dependency-free Node.js library for building Yapper bots",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "yapper",
    "bot",
    "sdk",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheRealEnvist/YapperJS.git"
  },
  "bugs": {
    "url": "https://github.com/TheRealEnvist/YapperJS/issues"
  },
  "homepage": "https://github.com/TheRealEnvist/YapperJS#readme",
  "sideEffects": false,
  "main": "./YapperJS/index.js",
  "types": "./YapperJS/index.d.ts",
  "exports": {
    ".": {
      "types": "./YapperJS/index.d.ts",
      "import": "./YapperJS/index.mjs",
      "require": "./YapperJS/index.js",
      "default": "./YapperJS/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "YapperJS/**/*.js",
    "YapperJS/**/*.mjs",
    "YapperJS/**/*.d.ts",
    "YapperJS/package.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "bot": "node examples/test-bot/bot.js",
    "bot:demo": "node examples/test-bot/demo.js",
    "test:bot": "node --test test/test-bot.test.js",
    "example": "node examples/bot/bot.js",
    "pack:check": "node scripts/check-package.js"
  }
}
